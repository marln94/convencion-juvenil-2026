{
  "name": "convencion-juvenil-2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "dev:registro": "pnpm --filter @convencion/registro dev",
    "dev:panel": "pnpm --filter @convencion/panel dev",
    "build:registro": "pnpm --filter @convencion/registro build",
    "build:panel": "pnpm --filter @convencion/panel build",
    "dev:api": "pnpm --filter @convencion/api dev:api",
    "setup:local": "pnpm --filter @convencion/api local-setup",
    "cdk:synth": "pnpm --filter @convencion/infra-cdk synth",
    "cdk:deploy": "pnpm --filter @convencion/infra-cdk deploy:cdk",
    "deploy:apps": "pnpm --filter @convencion/infra-cdk deploy:apps"
  }
}