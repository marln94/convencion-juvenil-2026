{
  "name": "@convencion/infra-cdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:lambdas": "node scripts/build-lambdas.mjs",
    "synth": "tsc -p tsconfig.json && node scripts/build-lambdas.mjs && cdk synth",
    "deploy:cdk": "tsc -p tsconfig.json && node scripts/build-lambdas.mjs && cdk deploy --all --outputs-file cdk-outputs.json",
    "deploy:apps": "node scripts/deploy-apps.mjs",
    "clean": "rm -rf dist dist-lambda cdk-outputs.json"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.188.0",
    "constructs": "^10.4.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.188.0",
    "typescript": "^5.6.3"
  }
}