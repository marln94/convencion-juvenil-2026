# Convención Juvenil 2026 — configuración de despliegue
# Copia a `<repo>/.env` y completa antes de ejecutar los deploys.

# Región y cuenta AWS donde se despliega la infraestructura.
CDK_REGION=us-east-1
CDK_ACCOUNT=

# -- Credenciales AWS (requeridas para `cdk deploy`, `deploy:apps` y `deploy:utils`)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=