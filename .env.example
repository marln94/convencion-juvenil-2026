# Entorno AWS
AWS_REGION=us-east-1

# Nombres de tablas DynamoDB (el stack CDK creará estos nombres)
PARTICIPANTES_TABLE=Convencion-Participantes
CONFIGURACION_TABLE=Convencion-Configuracion

# Bucket privado de comprobantes de pago
COMPROBANTES_BUCKET=convencion-comprobantes

# URL base de la API para el api-client (local, o el dominio de CloudFront tras el deploy)
API_BASE_URL=http://localhost:3000

# URL base de la API para el formulario público (apps/registro).
# Vacío = misma origen: en desarrollo se usa el proxy de Vite hacia localhost:3000
VITE_API_BASE_URL=